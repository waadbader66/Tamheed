# Copy to .env (never commit .env). All values stay on your computer.
# Everything works without these values: no Claude key = labelled rule-based fallback; no SMTP = invitations
# are prepared but not emailed (create a sign-in with: .venv/bin/python scripts/issue_temp_password.py <email>).

# --- Claude (AI assistant + personalised video narration) ---
# Create a key at https://console.anthropic.com -> API Keys. API usage is billed separately
# from a Claude.ai chat subscription; add credits under Plans & Billing first.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Invitation email (Gmail SMTP) ---
# Use a Gmail *App Password* (Google Account -> Security -> 2-Step Verification -> App passwords),
# not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Who may receive invitations: * = any address. Or a comma-separated list to restrict (Gmail +aliases allowed).
EMAIL_ALLOWLIST=*

APP_BASE_URL=http://localhost:5710

# --- Optional ---
# HR_PASSWORD=          # HR password for a NEW database (default for local demo: Rimal-HR-2026!)
# GRADUATE_DAYS=21      # days after completion before a hire moves to existing employees
# JUDGE_ACCESS=off      # judge sign-in (empty username + password) is on by default
